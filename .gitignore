.gradle
/local.properties
# Android Studio / IntelliJ project files: machine-specific, and rewritten on every Gradle sync.
# Only the shared code style is kept under version control.
/.idea/*
!/.idea/codeStyles/
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# Gradle build output of every module
build/

# Private reference material (scores, charts, PDFs). Only the icon sources are shared: they are
# what tools/icons.map converts, see additional/icons/README.md.
/additional/*
!/additional/icons/

# The Kotlin Gradle plugin writes per-project caches here.
.kotlin/

# The music font the notation glyphs were traced from; fetched on demand, never shipped.
# tools/bravura_glyphs.py --download
tools/.bravura/
